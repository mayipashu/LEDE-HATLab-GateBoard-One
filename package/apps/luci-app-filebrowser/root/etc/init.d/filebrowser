#!/bin/sh /etc/rc.common
# FileBrowser init script for OpenWrt 21.02
# 兼容 UCI 配置节类型 "filebrowser"

START=99
USE_PROCD=1

PROG=/usr/bin/filebrowser

start_service() {
	local enabled listen_port root_path base_url disable_exec

	config_load filebrowser
	config_get enabled "config" enabled 0
	config_get listen_port "config" listen_port 8989
	config_get root_path "config" root_path "/"
	config_get base_url "config" base_url ""
	config_get disable_exec "config" disable_exec 1

	[ "$enabled" -ne 1 ] && exit 0

	procd_open_instance
	procd_set_param command "$PROG" -p "$listen_port" -r "$root_path"

	if [ -n "$base_url" ]; then
		procd_append_param command --baseurl "$base_url"
	fi
	[ "$disable_exec" -eq 1 ] && procd_append_param command --disable-exec

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "filebrowser"
}
